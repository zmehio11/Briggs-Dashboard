# Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/briggs_dashboard"

# Server
PORT=4000
# Comma-separated list of business dates to backfill on first run, e.g. 2026-01-01
BACKFILL_START_DATE=2026-01-01

# --- Toast POS ---
# VERIFY against doc.toasttab.com under your account: Toast issues a
# "Standard API access" client id/secret per restaurant group (management
# group), and requires the target restaurant GUID on every request via the
# Toast-Restaurant-External-ID header.
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=
TOAST_API_BASE_URL=https://ws-api.toasttab.com

# --- Push Operations ---
# VERIFY exact auth flow (API key vs OAuth) and base URL against your Push
# Operations API docs / account rep.
PUSH_OPS_API_KEY=
PUSH_OPS_COMPANY_ID=
PUSH_OPS_LOCATION_ID=
PUSH_OPS_API_BASE_URL=https://api.pushoperations.com

# --- MarginEdge ---
# VERIFY exact auth flow and base URL against your MarginEdge partner API docs.
MARGIN_EDGE_API_KEY=
MARGIN_EDGE_RESTAURANT_ID=
MARGIN_EDGE_API_BASE_URL=https://api.marginedge.com

# --- QuickBooks Online ---
# Production Client ID/Secret from an Intuit Developer app (developer.intuit.com)
# -- NOT the sandbox/Development keys, since we want the real company's books.
# There's no static API key: after setting these, visit
# GET /api/quickbooks/connect in a browser (logged into the real QBO
# company) to authorize -- the resulting connection (refresh token +
# company/realm ID) is stored in Postgres, not an env var, since the
# refresh token rotates on every use.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# Must exactly match a Redirect URI registered on the Intuit app.
QUICKBOOKS_REDIRECT_URI=https://briggs-dashboard-production.up.railway.app/api/quickbooks/callback

# Frontend origin allowed to call this API (CORS)
FRONTEND_ORIGIN=http://localhost:5173
