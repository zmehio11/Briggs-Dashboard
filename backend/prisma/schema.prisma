generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per business date, sourced from Toast.
model DailySales {
  id          String   @id @default(cuid())
  businessDate DateTime @unique @db.Date
  grossSales  Decimal  @db.Decimal(12, 2)
  netSales    Decimal  @db.Decimal(12, 2)
  discounts   Decimal  @db.Decimal(12, 2) @default(0)
  orderCount  Int      @default(0)
  covers      Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([businessDate])
}

/// One row per business date, sourced from Push Operations.
model DailyLabor {
  id             String   @id @default(cuid())
  businessDate   DateTime @unique @db.Date
  regularHours   Decimal  @db.Decimal(8, 2) @default(0)
  overtimeHours  Decimal  @db.Decimal(8, 2) @default(0)
  totalLaborCost Decimal  @db.Decimal(12, 2)
  employeeCount  Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@index([businessDate])
}

/// One row per business date + category, sourced from MarginEdge.
model DailyCogs {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date
  category     String   // e.g. "food", "beverage", "paper", "other"
  amount       Decimal  @db.Decimal(12, 2)
  updatedAt    DateTime @updatedAt

  @@unique([businessDate, category])
  @@index([businessDate])
}

/// One row per business date + menu item, sourced from Toast. Only
/// top-level menu item selections count (not modifiers, not gift cards).
model DailyItemSales {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date
  itemGuid     String
  itemName     String
  categoryName String?
  quantity     Int
  revenue      Decimal  @db.Decimal(12, 2)
  updatedAt    DateTime @updatedAt

  @@unique([businessDate, itemGuid])
  @@index([businessDate])
}

/// One row per calendar month, imported from the Excel operating budget.
/// Fiscal "Month 1" in the workbook maps to whichever real month the
/// restaurant opened (see backend/scripts/parse-budget.py) — this table
/// only ever stores real calendar year/month, so the dashboard API can join
/// on it directly.
model BudgetMonth {
  id           String   @id @default(cuid())
  year         Int
  month        Int      // 1-12, calendar month
  totalRevenue Decimal  @db.Decimal(12, 2)
  totalCogs    Decimal  @db.Decimal(12, 2)
  totalLabor   Decimal  @db.Decimal(12, 2)
  updatedAt    DateTime @updatedAt

  @@unique([year, month])
}

/// One row per business date + position, sourced from Push Operations.
/// Lets the Labour tab break sales-vs-labor down by FOH/BOH for
/// scheduling, not just a single daily total.
model DailyLaborByPosition {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date
  positionName String
  group        String // FOH | BOH | Management | Other
  hours        Decimal  @db.Decimal(8, 2)
  cost         Decimal  @db.Decimal(12, 2)
  employeeCount Int     @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([businessDate, positionName])
  @@index([businessDate])
}

/// Current theoretical cost per unit for every sellable recipe, sourced
/// from MarginEdge. Refreshed on every nightly sync (whole-menu snapshot,
/// not per business date) — matched against Toast item names by
/// normalizedName since the two systems share no common ID.
model RecipeCost {
  id             String   @id @default(cuid())
  recipeId       String   @unique
  recipeName     String
  normalizedName String
  unitCost       Decimal  @db.Decimal(10, 4)
  unit           String
  categoryType   String // MENU | BAR
  updatedAt      DateTime @updatedAt

  @@index([normalizedName])
}

/// A specific check/discount/void worth an owner's attention -- not a log
/// of every transaction, just the ones that trip a rule (self-approved
/// comp, a check voided after it was paid, a check with unusually many
/// voided items, or a refund). One row per (check, flag type).
model TransactionFlag {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date
  orderGuid    String
  checkGuid    String
  employeeGuid String?
  employeeName String?
  flagType     String // "self_approved_discount" | "large_discount" | "void_after_payment" | "multiple_voids" | "refund"
  severity     String // "high" | "medium"
  amount       Decimal  @db.Decimal(12, 2)
  description  String
  createdAt    DateTime @default(now())

  @@unique([checkGuid, flagType])
  @@index([businessDate])
}

/// A local partnership/sponsorship/press/influencer contact for the
/// Marketing Engine's Community Outreach Tracker. Owner-managed CRUD, not
/// synced from any vendor.
model OutreachContact {
  id              String    @id @default(cuid())
  name            String
  organization    String?
  type            String // "Partnership" | "Sponsorship" | "Influencer" | "Local Press" | "Community Event" | "Other"
  status          String    @default("Not Contacted") // "Not Contacted" | "Contacted" | "In Discussion" | "Active" | "Declined"
  contactInfo     String?
  notes           String?
  lastContactDate DateTime? @db.Date
  nextActionDate  DateTime? @db.Date
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
}

/// Manual override linking one Toast menu item to its real MarginEdge
/// recipe, for the ~85% of items automatic normalized-name matching
/// misses (different naming conventions between the two systems --
/// "Steak Frites 5oz" in Toast vs. whatever MarginEdge calls it). Always
/// takes priority over the automatic match in items.ts.
model ItemCostMapping {
  id        String   @id @default(cuid())
  itemGuid  String   @unique
  recipeId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per business date -- the "Daily Sales & Cash Report" sheet's
/// fields, sourced from Toast. Cash Tips / Opening Float / Actual Cash
/// Count are deliberately not modeled: confirmed unused by Briggs (cash
/// tips stay with servers, no drawer float/count tracked).
model DailyCashout {
  id            String   @id @default(cuid())
  businessDate  DateTime @unique @db.Date
  foodSales     Decimal  @db.Decimal(12, 2) @default(0)
  liquorSales   Decimal  @db.Decimal(12, 2) @default(0)
  wineSales     Decimal  @db.Decimal(12, 2) @default(0)
  beerSales     Decimal  @db.Decimal(12, 2) @default(0)
  naBevSales    Decimal  @db.Decimal(12, 2) @default(0)
  otherSales    Decimal  @db.Decimal(12, 2) @default(0)
  discounts     Decimal  @db.Decimal(12, 2) @default(0)
  voids         Decimal  @db.Decimal(12, 2) @default(0)
  gst           Decimal  @db.Decimal(12, 2) @default(0)
  ccTipsTotal   Decimal  @db.Decimal(12, 2) @default(0)
  cashPayments  Decimal  @db.Decimal(12, 2) @default(0)
  cardPayments  Decimal  @db.Decimal(12, 2) @default(0)
  otherPayments Decimal  @db.Decimal(12, 2) @default(0)
  covers        Int      @default(0)
  updatedAt     DateTime @updatedAt
}

/// One row per business date + FOH/Bar server (by Toast payment.server),
/// feeding the Tips Payout sheet's individual server rows. role is
/// FOH_Server (8.5% house cut) for any named individual, Bar_Server (7%,
/// redirected to the Bar Team hourly pool) only for the two shared
/// "Bar Day"/"Bar Night" POS logins -- confirmed against the real
/// spreadsheet that a named bartender still gets 8.5% individually, not
/// the Bar rate (Toast job title alone doesn't decide this). Computed at
/// sync time, not read time, so a later reclassification doesn't
/// retroactively rewrite historical payouts.
model DailyServerTips {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date
  employeeGuid String
  employeeName String
  role         String // "FOH_Server" | "Bar_Server"
  netSales     Decimal  @db.Decimal(12, 2)
  ccTips       Decimal  @db.Decimal(12, 2)
  houseCutPct  Decimal  @db.Decimal(5, 4)
  updatedAt    DateTime @updatedAt

  @@unique([businessDate, employeeGuid])
  @@index([businessDate])
}

/// Manual correction for one server's one day, when the Toast-sourced
/// figure is known to be wrong -- e.g. a private event or off-POS tab that
/// never went through Toast at all, so no amount of API digging will ever
/// surface it. Always takes priority over the synced DailyServerTips row
/// for that (businessDate, employeeGuid) at read time; a null field means
/// "don't override this one," so a manager can fix just netSales while
/// leaving ccTips as Toast reported it, or vice versa.
model ServerTipsOverride {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date
  employeeGuid String
  employeeName String
  netSales     Decimal? @db.Decimal(12, 2)
  ccTips       Decimal? @db.Decimal(12, 2)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessDate, employeeGuid])
  @@index([businessDate])
}

/// One row per business date + employee + position, from Push Operations
/// -- named hours for the tips-payout hourly pools (BOH/Support/Bar). A
/// person can have more than one row on the same date if they worked more
/// than one position that day (e.g. bartender one shift, FOH manager
/// another) -- each position's hours route to a different pool (or none,
/// for a management position -- see classifyTipPool.ts).
model DailyEmployeeTipHours {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date
  employeeId   Int
  employeeName String
  positionName String
  pool         String? // "BOH" | "Support" | "Bar" | null (not pool-eligible)
  hours        Decimal  @db.Decimal(8, 2)
  cost         Decimal  @db.Decimal(12, 2)
  updatedAt    DateTime @updatedAt

  @@unique([businessDate, employeeId, positionName])
  @@index([businessDate])
}

/// The one genuinely-manual field in the whole cashout tab: a flat
/// per-day presence toggle for the fixed 3-person Leadership pool
/// (confirmed with the owner -- not derived from Push's real clocked
/// hours for these 3 people).
model DailyLeadershipPresence {
  id           String   @id @default(cuid())
  businessDate DateTime @db.Date
  leaderName   String
  present      Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@unique([businessDate, leaderName])
}

/// Audit trail for the nightly sync job.
model SyncLog {
  id         String   @id @default(cuid())
  source     String   // "toast" | "push_operations" | "margin_edge"
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  status     String   // "success" | "failed"
  rowsWritten Int     @default(0)
  errorMessage String?
}

/// Single-row OAuth connection to one QuickBooks Online company (Briggs'
/// real company, not the Intuit sandbox). refreshToken rotates on every
/// use and is valid ~100 days -- always overwritten with the latest one
/// returned, never reused after a refresh. accessToken is cached with its
/// expiry so most requests skip the refresh round-trip (valid ~1 hour).
model QuickbooksConnection {
  id                String   @id @default(cuid())
  realmId           String   @unique
  accessToken       String
  accessTokenExpiresAt DateTime
  refreshToken      String
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// One row per calendar month + expense account, sourced from QuickBooks'
/// Profit and Loss report (Expenses section only -- COGS is MarginEdge's
/// job, not QuickBooks'). category is the QBO account name verbatim (e.g.
/// "Rent Expense", "Utilities", "Insurance").
model MonthlyExpense {
  id        String   @id @default(cuid())
  year      Int
  month     Int // 1-12, calendar month
  category  String
  amount    Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt

  @@unique([year, month, category])
  @@index([year, month])
}
