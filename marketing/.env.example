# Copy to .env.local and fill in as each integration goes live.
# Nothing here is read yet — every adapter in src/lib/adapters/ currently
# points at mock data (see src/lib/adapters/index.ts). Wiring a real
# adapter is: (1) fill in its env vars below, (2) implement its adapter
# file's real client, (3) flip the export in index.ts. See README.md for
# what each key/scope is for and where to get it.

# --- POS (Toast) ---
# The Briggs operations dashboard (../backend) already has a working Toast
# integration for this restaurant — reuse its credentials/client rather
# than re-registering a second Toast app if possible.
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=
TOAST_API_BASE_URL=https://ws-api.toasttab.com

# --- Reservations (OpenTable / Resy) ---
OPENTABLE_API_KEY=
OPENTABLE_RESTAURANT_ID=
RESY_API_KEY=

# --- Social: Meta (Instagram + Facebook) ---
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Social: TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# --- Email (Mailchimp or Klaviyo — pick one) ---
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
KLAVIYO_API_KEY=

# --- SMS (Twilio or Attentive — pick one) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ATTENTIVE_API_KEY=

# --- Reviews: Google Business Profile ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# --- Reviews: Yelp Fusion ---
YELP_API_KEY=
YELP_BUSINESS_ID=
